# ──────────────────────────────────────────────────────────────────────────────
# .env.example  —  StudyBuddy environment variables
#
# Copy this file to .env and fill in your own values.
# NEVER commit .env to Git — it is listed in .gitignore.
# Your team-mate gets the values from you directly (e.g. via WhatsApp/Teams).
#
# Expo reads variables prefixed with EXPO_PUBLIC_ on both iOS and Android.
# Variables WITHOUT that prefix are only available on the build server (EAS).
# ──────────────────────────────────────────────────────────────────────────────

# ── Firebase (Phase 2) ────────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Dictionary API ────────────────────────────────────────────────────────────
# No key needed — the Free Dictionary API is completely public.
# EXPO_PUBLIC_DICTIONARY_BASE_URL is set in dictionaryService.ts directly.

# ── EAS Build (Phase 8) ───────────────────────────────────────────────────────
# EAS_PROJECT_ID is added automatically by `eas init` — do not set manually.
